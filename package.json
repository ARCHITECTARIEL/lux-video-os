{
    "name": "lux-video-os",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node server/index.js",
        "worker": "node worker/render-worker.mjs",
        "check:imports": "node tools/check-imports.mjs",
        "build:production": "node tools/build-production.mjs",
        "build:preview": "node tools/build-production.mjs --preview",
        "scan:client-privacy": "node tools/scan-client-provider-privacy.mjs",
        "test": "npm run test:unit",
        "test:unit": "node --test tests/*.test.mjs && vitest run",
        "test:codeql-gate": "node --test tests/codeql-sarif-gate.test.mjs",
        "codeql:enforce": "node tools/enforce-codeql-sarif.mjs",
        "test:e2e": "playwright test",
        "db:check": "drizzle-kit check",
        "db:verify": "node tools/check-migrations.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:dry-run": "node tools/dry-run-migrations.mjs",
        "workflow:validate": "workflow validate --dir workflows --strict",
        "workflow:build": "workflow build --target vercel-build-output-api",
        "hyperframes:snapshot": "node tools/create-hyperframes-snapshot.mjs",
        "hyperframes:sandbox-proof": "node tools/run-hyperframes-sandbox-proof.mjs"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@sentry/node": "^10.74.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/blob": "latest",
        "@vercel/sandbox": "2.8.0",
        "ai": "^7.0.0",
        "bufferutil": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "ffmpeg-static": "latest",
        "stripe": "^22.6.2",
        "workflow": "^4.8.9",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "drizzle-kit": "^0.31.10",
        "hyperframes": "0.7.64",
        "vercel": "^59.23.2",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@vercel/blob": {
            "undici": "6.28.1"
        },
        "@vercel/sandbox": {
            "undici": "7.29.1"
        },
        "@workflow/core": {
            "nanoid": "5.1.16",
            "devalue": "5.9.4"
        },
        "@workflow/world-local": {
            "undici": "7.29.1"
        },
        "@workflow/world-vercel": {
            "undici": "7.29.1"
        },
        "tar": "7.5.22",
        "http-cache-semantics": "4.3.0"
    }
}

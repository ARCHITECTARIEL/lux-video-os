{
    "name": "lux-video-os",
    "private": true,
    "type": "module",
    "scripts": {
        "check:imports": "node tools/check-imports.mjs",
        "build:production": "node tools/build-production.mjs",
        "build:preview": "node tools/build-production.mjs --preview",
        "scan:client-privacy": "node tools/scan-client-provider-privacy.mjs",
        "test": "npm run test:unit",
        "test:unit": "node --test tests/*.test.mjs && vitest run",
        "test:e2e": "playwright test",
        "db:check": "drizzle-kit check",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:dry-run": "node tools/dry-run-migrations.mjs",
        "workflow:validate": "workflow validate --dir workflows --strict",
        "workflow:build": "workflow build --target vercel-build-output-api"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@sentry/node": "^10.65.0",
        "@vercel/blob": "latest",
        "bufferutil": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "ffmpeg-static": "latest",
        "stripe": "^22.3.1",
        "workflow": "^4.6.1",
        "ws": "^8.21.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "drizzle-kit": "^0.31.10",
        "vercel": "^56.2.0",
        "vitest": "^4.1.10"
    }
}

*.db
*.db-*

# Generated customer media and operational exports
archive/
public/data/
public/video-os.json
public/exports/
public/uploads/

# Logs, caches, and process state
*.log
*.jsonl
server.pid
server-test.*
__pycache__/
*.py[cod]

# Local QA captures, backups, and patch artifacts
/qa-*.png
*backup*
*.bak

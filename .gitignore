playwright-report/

# Workspace and containment state
.omx/
.lazyweb/
.containment/
.pytest_cache/
.vscode/
.workflow-data/
.claude/

# Environment, credentials, and certificates
.env
.env.*
!.env.example
*.env
stale-vercel-env-*
.lux-secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer


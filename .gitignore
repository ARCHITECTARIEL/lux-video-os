# Dependencies and generated build output
.proof/
node_modules/
.vercel/
.swc/
dist/
coverage/
test-results/
playwright-report/

# Workspace and containment state
.omx/
.lazyweb/
.containment/
.pytest_cache/
.vscode/
.workflow-data/
.claude/

# Environment, credentials, and certificates
.env
.env.*
!.env.example
*.env
stale-vercel-env-*
.lux-secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local transactional/customer state
data/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Generated customer media and operational exports
archive/
public/data/
public/video-os.json
public/exports/
public/uploads/

# Logs, caches, and process state
*.log
*.jsonl
server.pid
server-test.*
__pycache__/
*.py[cod]

# Local QA captures, backups, and patch artifacts
/qa-*.png
*backup*
*.bak
*.tmp
*.patch

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
.vercel
.env*

# Stray CLI credential/telemetry dumps (accidental artifacts, never commit)
limit=*/
until=*/

# Per-suite Playwright result dirs (not the gitignored default test-results/)
test-results-*/

# Brand pack (brand-assets/): only LUTs and logos are tracked while the repo is
# public. Fonts and music stay in %USERPROFILE%\lux-assets until it is private.
brand-assets/fonts/
brand-assets/music/
# Production inputs that hold personal data or paid outputs never go in git.
video_productions/**/consent*.json
video_productions/**/receipt.json
video_productions/**/*.wav
video_productions/**/*.mp4
video_productions/**/*.mov
video_productions/**/render/
video_productions/**/heygen-state.json
video_productions/**/voice-words.json

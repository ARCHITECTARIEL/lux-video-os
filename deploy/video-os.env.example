# Copy to /etc/video-os/video-os.env on the VPS (chmod 600, owned by the
# video-os service user) and fill in real values. Loaded by both systemd
# units via EnvironmentFile= -- see deploy/systemd/*.service.

# --- Core platform ---
PORT=8080
HOST=127.0.0.1
NODE_ENV=production

# Vercel Workflow's start() only works inside Vercel's own runtime (see the
# comment above dispatchesViaVercelWorkflow() in api/video-os-lite/render-v2.js).
# Any value other than "vercel" here makes render dispatch a no-op after
# claimWorkflowStart(); worker/render-worker.mjs's poll loop drives the job
# forward instead. This must be set for renders to complete on a VPS.
WORKFLOW_DISPATCH_MODE=poll

# --- Database (Neon, unchanged from Vercel hosting) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Private object storage ---
# Default driver is "blob" (Vercel Blob, which works from any host with a
# token -- no code change needed to keep using it). Set STORAGE_DRIVER=fs
# and STORAGE_FS_ROOT only if you're deliberately moving storage onto the
# VPS's own disk instead; see lib/storage-drivers/fs-blob-driver.js.
BLOB_READ_WRITE_TOKEN=
# STORAGE_DRIVER=fs
# STORAGE_FS_ROOT=/var/lib/video-os/blob

# --- Sessions & public origin ---
VIDEO_OS_SESSION_SECRET=
VIDEO_OS_PUBLIC_ORIGIN=https://your-domain.example

# --- Render worker ---
RENDER_WORKER_POLL_MS=8000
RENDER_WORKER_CONCURRENCY=4

# Standard is simulation unless this is explicitly set to runpod. RunPod mode
# submits one bounded, hash-bound portrait+audio request and polls the queue API.
VIDEO_OS_STANDARD_PROVIDER=simulation
VIDEO_OS_RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# VIDEO_OS_RUNPOD_API_ORIGIN=https://api.runpod.ai/v2
# VIDEO_OS_RUNPOD_TIMEOUT_MS=30000
# VIDEO_OS_RUNPOD_MAX_INPUT_BYTES=7000000
# VIDEO_OS_RUNPOD_MAX_OUTPUT_BYTES=7000000
# Infrastructure-proof endpoints return simulation=true and are rejected unless
# this is explicitly true. Keep false/unset for real canary and production.
# VIDEO_OS_RUNPOD_ALLOW_SIMULATED_OUTPUT=false

# --- Feature flags (copy current values from the Vercel project) ---
VIDEO_OS_DURABLE_WORKFLOW_ENABLED=
VIDEO_OS_HOSTED_FINISHING_ENABLED=
VIDEO_OS_BILLING_ENABLED=
VIDEO_OS_STANDARD_RENDER_ENABLED=
VIDEO_OS_STANDARD_NARRATION_SCHEMA_READY=
VIDEO_OS_STANDARD_NARRATION_POLICY_APPROVED=
VIDEO_OS_STANDARD_NARRATION_PRICING_APPROVED=

# --- Providers / billing / email (copy current values from the Vercel project) ---
HEYGEN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECT_LIVEMODE=
RESEND_API_KEY=
AUTH_FROM_EMAIL=

# --- Auth / admin ---
# Workspace credentials: the customer-facing password sign-in option (the
# consumer modal's "Username"/"Password" fields, alongside Google and
# magic-link). Leaving these unset makes that path 503 rather than break.
VIDEO_OS_WORKSPACE_USERNAME=
VIDEO_OS_WORKSPACE_PASSWORD=
# Admin credentials: gate /admin-console only (api/video-os-lite/auth.js's
# action=admin-login) -- a completely separate login from the workspace
# credentials above, and never reachable from the customer-facing modal.
VIDEO_OS_ADMIN_USERNAME=
VIDEO_OS_ADMIN_PASSWORD=
VIDEO_OS_ADMIN_TOKEN=
VIDEO_OS_CEO_ACCESS_TOKEN=
VIDEO_OS_CEO_EMAIL=
VIDEO_OS_RENDER_ACCOUNT_ID=

# Google sign-in (lib/google-oauth.js). From a Google Cloud Console OAuth
# client (type: Web application). Authorized redirect URI must be exactly
# <VIDEO_OS_PUBLIC_ORIGIN>/api/video-os-lite/google-callback. Leaving these
# unset makes the "Continue with Google" button 501 rather than break --
# same pattern as RESEND_API_KEY/AUTH_FROM_EMAIL gating magic-link sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
